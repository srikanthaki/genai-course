import os
from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()
client = OpenAI(
    api_key=os.getenv("OPENAI_API_KEY")
)

model = "gpt-4o-mini"


print("="*10)
print("Example 1: Simple API Call")
print("="*10)

message = [
    {"role": "system", "content": "You are a helpful assistant.keep answers in 2 sentences and understanble way for a 5-year-old."},
    {"role": "user", "content":"what is Gen AI"},
]

response = client.chat.completions.create(
    model=model,
    messages=message,
    temperature=0.7,
)

print(f"Assistant: {response.choices[0].message.content}")